DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vykhidni_db"
GEMINI_API_KEY=//read readme.md
# Додаткові акаунти Gemini з безкоштовними лімітами (fallback-ланцюжок: GEMINI_API_KEY → GEMINI_API_KEY_2 → ...).
# GEMINI_MODEL — модель для першого акаунта (за замовчуванням gemini-3.5-flash-lite).
# GEMINI_MODEL_2 — модель для другого акаунта.
# Необов'язково
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY_2=//read readme.md
# GEMINI_MODEL_2=gemini-3.5-flash-lite
# Необов'язково
# GOOGLE_MAPS_API_KEY=//read readme.md
# PORT=3000
# HOST=127.0.0.1
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
