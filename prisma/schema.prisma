generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteConfig {
  id              Int                 @id @default(autoincrement())
  name            String
  startUrl        String              @unique
  actions         Json
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  status          String              @default("ACTIVE") // ACTIVE | DRAFT | REVIEW | FAILED
  sourceType      String? // jsonld | microdata | heuristic | llm | manual
  discoveryReport Json?
  deletedAt       DateTime?
  events          Event[]

  @@index([deletedAt])
}

model Event {
  id           Int        @id @default(autoincrement())
  title        String
  date         String?
  time         String?
  location     String?
  description  String?
  image        String?
  unixTime     Int?
  coordinates  String?
  url          String     @unique
  status       String     @default("DRAFT")
  createdAt    DateTime   @default(now())
  siteConfigId Int
  siteConfig   SiteConfig @relation(fields: [siteConfigId], references: [id])
  category     String?
  isForKids    Boolean?
  aiProcessed  Boolean    @default(false)
}
